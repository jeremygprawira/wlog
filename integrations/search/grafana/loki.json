{
  "title": "wlog on Loki",
  "uid": "wlog-loki",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Rate by operation",
      "type": "timeseries",
      "targets": [
        {"expr": "sum by (operation) (rate({service=\"$service\"} | json | unwrap duration_ms [5m]))", "refId": "A"}
      ]
    },
    {
      "id": 2,
      "title": "Errors by code",
      "type": "timeseries",
      "targets": [
        {"expr": "sum by (error_code) (count_over_time({service=\"$service\"} | json | level=\"error\" [5m]))", "refId": "A"}
      ]
    },
    {
      "id": 3,
      "title": "p95 duration by operation",
      "type": "timeseries",
      "targets": [
        {"expr": "quantile_over_time(0.95, {service=\"$service\"} | json | unwrap duration_ms [5m]) by (operation)", "refId": "A"}
      ]
    }
  ]
}
